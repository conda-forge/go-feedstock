+// Exercise both the runtime/cgo load-config name collision and the MSVC
+// startup objects needed by stack-protected C code during internal linking.
+func TestWindowsMSVCInternalCRT(t *testing.T) {
+	goTool := mustHaveMSVC(t)
+	if runtime.GOARCH != "arm64" {
+		t.Skip("Windows ARM64 internal CRT regression")
+	}
+	dir := t.TempDir()
+	src := filepath.Join(dir, "main.go")
+	const code = `package main
+/*
+#cgo CFLAGS: -fstack-protector-all
+#include <string.h>
+int copylen(const char *s) {
+ char buf[32];
+ strcpy(buf, s);
+ return (int)strlen(buf);
+}
+*/
+import "C"
+func main() { if C.copylen(C.CString("hello")) != 5 { panic("C result") } }
+`
+	if err := os.WriteFile(src, []byte(code), 0666); err != nil {
+		t.Fatal(err)
+	}
+	exe := filepath.Join(dir, "main.exe")
+	if out, err := testenv.Command(t, goTool, "build", "-ldflags=-linkmode=internal", "-o", exe, src).CombinedOutput(); err != nil {
+		t.Fatalf("build: %v\n%s", err, out)
+	}
+	f, err := pe.Open(exe)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	oh := f.OptionalHeader.(*pe.OptionalHeader64)
+	dd := oh.DataDirectory[pe.IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG]
+	var config []byte
+	for _, sect := range f.Sections {
+		if dd.VirtualAddress >= sect.VirtualAddress && uint64(dd.VirtualAddress-sect.VirtualAddress)+uint64(dd.Size) <= uint64(sect.Size) {
+			data, err := sect.Data()
+			if err != nil {
+				t.Fatal(err)
+			}
+			off := dd.VirtualAddress - sect.VirtualAddress
+			config = data[off : off+dd.Size]
+			break
+		}
+	}
+	if len(config) < 148 {
+		t.Fatalf("load config is outside file-backed sections: %+v", dd)
+	}
+	cookie := binary.LittleEndian.Uint64(config[88:96])
+	if cookie < oh.ImageBase || cookie >= oh.ImageBase+uint64(oh.SizeOfImage) {
+		t.Fatalf("invalid cookie address %#x", cookie)
+	}
+	if flags := binary.LittleEndian.Uint32(config[144:148]); flags&IMAGE_GUARD_SECURITY_COOKIE_UNUSED != 0 {
+		t.Fatalf("cookie marked unused: %#x", flags)
+	}
+	if out, err := testenv.Command(t, exe).CombinedOutput(); err != nil {
+		t.Fatalf("execute: %v\n%s", err, out)
+	}
+}
