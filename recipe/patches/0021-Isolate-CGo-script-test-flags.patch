+# Isolate conda's fallback flags: this test varies CGO_* to distinguish
+# ordinary flags from flags that specifically require external linking.
+env CFLAGS=-O2
+env CXXFLAGS=-O2
+env FFLAGS=-O2
+env LDFLAGS=-g
+
