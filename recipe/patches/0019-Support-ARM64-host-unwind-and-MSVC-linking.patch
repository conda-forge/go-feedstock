+
+// selectAssociativeSections follows COFF section associations before loading
+// relocations. Children of a discarded COMDAT must not survive independently.
+func (state *peLoaderState) selectAssociativeSections() error {
+	state.discarded = make(map[uint16]bool)
+	for i, n := 0, 0; i < len(state.f.COFFSymbols); i += n + 1 {
+		s := &state.f.COFFSymbols[i]
+		n = int(s.NumberOfAuxSymbols)
+		if s.SectionNumber <= 0 || s.StorageClass != IMAGE_SYM_CLASS_EXTERNAL {
+			continue
+		}
+		sec := uint16(s.SectionNumber - 1)
+		size, ok := state.comdats[sec]
+		if !ok {
+			continue
+		}
+		name, err := s.FullName(state.f.StringTable)
+		if err != nil {
+			return err
+		}
+		if state.arch.Family == sys.I386 && strings.HasPrefix(name, "_") && name != "_main" && !strings.HasPrefix(name, "__imp_") {
+			name = name[1:]
+		}
+		if i := strings.LastIndex(name, "@"); i >= 0 {
+			name = name[:i]
+		}
+		if old, found := comdatDefinitions[name]; found && old == size {
+			state.discarded[sec] = true
+		}
+	}
+	visiting, done := make(map[uint16]bool), make(map[uint16]bool)
+	var visit func(uint16) error
+	visit = func(child uint16) error {
+		if done[child] {
+			return nil
+		}
+		if visiting[child] {
+			return fmt.Errorf("cyclic associative COMDAT section %d", child+1)
+		}
+		visiting[child] = true
+		if parent, ok := state.associative[child]; ok {
+			if state.f.Sections[parent].Characteristics&pe.IMAGE_SCN_LNK_COMDAT == 0 {
+				return fmt.Errorf("associative COMDAT parent %d is not COMDAT", parent+1)
+			}
+			if err := visit(parent); err != nil {
+				return err
+			}
+			if state.discarded[parent] {
+				state.discarded[child] = true
+			}
+		}
+		visiting[child] = false
+		done[child] = true
+		return nil
+	}
+	for child := range state.associative {
+		if err := visit(child); err != nil {
+			return err
+		}
+	}
+	return nil
+}
