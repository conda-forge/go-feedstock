+		{"discard duplicate chain", map[uint16]uint16{1: 0, 2: 1}, true, false, ""},
+		{"cycle", map[uint16]uint16{1: 2, 2: 1}, false, false, "cyclic"},
+		{"non COMDAT parent", map[uint16]uint16{1: 0}, false, true, "not COMDAT"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			saved := comdatDefinitions
+			defer func() { comdatDefinitions = saved }()
+			comdatDefinitions = map[string]int64{}
+			if tt.duplicate {
+				comdatDefinitions["foo"] = -1
+			}
+			f := &pe.File{COFFSymbols: []pe.COFFSymbol{{Name: [8]byte{'f', 'o', 'o'}, SectionNumber: 1, StorageClass: IMAGE_SYM_CLASS_EXTERNAL}}}
+			for range 3 {
+				f.Sections = append(f.Sections, &pe.Section{SectionHeader: pe.SectionHeader{Characteristics: pe.IMAGE_SCN_LNK_COMDAT}})
+			}
+			if tt.ordinaryParent {
+				f.Sections[0].Characteristics = 0
+			}
+			state := peLoaderState{arch: sys.ArchARM64, f: f, comdats: map[uint16]int64{0: -1}, associative: tt.associations}
+			err := state.selectAssociativeSections()
