@@ -144,3 +147,76 @@ func findHandlerInXDataAMD64(ldr *loader.Loader, xsym sym.LoaderSym, add int64)
 	}
 	return xrels.At(idx).Sym()
 }
+
+// ARM64 RUNTIME_FUNCTION is an 8-byte pair: start RVA followed by
+// either a packed unwind word (low bits nonzero) or an xdata RVA.
+// https://learn.microsoft.com/en-us/cpp/build/arm64-exception-handling
+func processSEHARM64(ldr *loader.Loader, pdata sym.LoaderSym) ([]loader.Sym, error) {
+	data, rels := ldr.Data(pdata), ldr.Relocs(pdata)
+	if len(data)%8 != 0 {
+		return nil, fmt.Errorf("invalid ARM64 pdata size %d", len(data))
+	}
+	byOffset := make(map[int32]int)
+	for i := 0; i < rels.Count(); i++ {
+		r := rels.At(i)
+		if r.Off() < 0 || int(r.Off())+4 > len(data) || r.Off()%4 != 0 || r.Siz() != 4 || r.Type() != objabi.R_PEIMAGEOFF {
+			return nil, fmt.Errorf("invalid ARM64 pdata relocation at %d", r.Off())
+		}
+		if _, ok := byOffset[r.Off()]; ok {
+			return nil, fmt.Errorf("duplicate ARM64 pdata relocation at %d", r.Off())
+		}
+		byOffset[r.Off()] = i
+	}
+	var entries []loader.Sym
+	for off := 0; off < len(data); off += 8 {
+		idx, ok := byOffset[int32(off)]
+		if !ok || rels.At(idx).Sym() == 0 {
+			return nil, fmt.Errorf("missing ARM64 pdata function relocation at %d", off)
+		}
+		packed := binary.LittleEndian.Uint32(data[off+4:]) & 3
+		xidx, hasX := byOffset[int32(off+4)]
+		if packed == 3 || (packed == 0) != hasX {
+			return nil, fmt.Errorf("invalid ARM64 unwind encoding at %d", off)
+		}
+		ent := ldr.MakeSymbolBuilder("")
+		ent.SetType(sym.SSEHSECT)
+		ent.SetAlign(4)
+		ent.SetSize(8)
+		ent.SetData(append([]byte(nil), data[off:off+8]...))
+		keep := func(from, to loader.Sym) {
+			if to != 0 {
+				r, _ := ldr.MakeSymbolUpdater(from).AddRel(objabi.R_KEEP)
+				r.SetSym(to)
+			}
+		}
+		keep(rels.At(idx).Sym(), ent.Sym())
+		for _, o := range []int32{int32(off), int32(off + 4)} {
+			if i, ok := byOffset[o]; ok {
+				old := rels.At(i)
+				typ := old.Type()
+				if old.Weak() {
+					typ |= objabi.R_WEAK
+				}
+				r, _ := ent.AddRel(typ)
+				r.SetOff(o - int32(off))
+				r.SetSiz(old.Siz())
+				r.SetSym(old.Sym())
+				r.SetAdd(old.Add())
+			}
+		}
+		if hasX {
+			xs := rels.At(xidx).Sym()
+			if xs == 0 {
+				return nil, fmt.Errorf("missing ARM64 xdata symbol")
+			}
+			keep(ent.Sym(), xs)
+			// Retain handler/filter targets referenced by the retained unwind data.
+			xr := ldr.Relocs(xs)
+			for i := 0; i < xr.Count(); i++ {
+				keep(ent.Sym(), xr.At(i).Sym())
+			}
+		}
+		entries = append(entries, ent.Sym())
+	}
+	return entries, nil
+}
