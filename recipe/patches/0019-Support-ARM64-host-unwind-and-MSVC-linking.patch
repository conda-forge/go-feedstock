+
+package loadpe
+
+import (
+	"cmd/internal/objabi"
+	"cmd/link/internal/loader"
+	"cmd/link/internal/sym"
+	"encoding/binary"
+	"strings"
+	"testing"
+)
+
+func TestARM64UnwindRecords(t *testing.T) {
+	for _, tt := range []struct {
+		name  string
+		word  uint32
+		size  int
+		fn, x bool
+		want  string
+	}{
+		{"packed", 1, 8, true, false, ""},
+		{"packed fragment", 2, 8, true, false, ""},
+		{"unpacked", 0, 8, true, true, ""},
+		{"truncated", 1, 7, true, false, "size"},
+		{"missing function", 1, 8, false, false, "function relocation"},
+		{"reserved", 3, 8, true, false, "encoding"},
+		{"missing xdata", 0, 8, true, false, "encoding"},
+		{"packed with xdata", 1, 8, true, true, "encoding"},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			l := loader.NewLoader(0, &loader.ErrorReporter{})
+			f := l.MakeSymbolBuilder("function")
+			f.SetType(sym.STEXT)
+			x := l.MakeSymbolBuilder("unwind")
+			x.SetType(sym.SSEHSECT)
+			h := l.MakeSymbolBuilder("handler")
+			h.SetType(sym.STEXT)
+			hr, _ := x.AddRel(objabi.R_PEIMAGEOFF)
+			hr.SetSym(h.Sym())
+			hr.SetSiz(4)
+			p := l.MakeSymbolBuilder("pdata")
+			p.SetType(sym.SSEHSECT)
+			data := make([]byte, 8)
+			binary.LittleEndian.PutUint32(data[4:], tt.word)
+			p.SetData(data[:tt.size])
+			p.SetSize(int64(tt.size))
+			if tt.fn {
+				r, _ := p.AddRel(objabi.R_PEIMAGEOFF)
+				r.SetSym(f.Sym())
+				r.SetSiz(4)
+				r.SetAdd(12)
+			}
+			if tt.x {
+				r, _ := p.AddRel(objabi.R_PEIMAGEOFF)
+				r.SetSym(x.Sym())
+				r.SetSiz(4)
+				r.SetOff(4)
+			}
+			got, err := processSEHARM64(l, p.Sym())
+			if tt.want != "" {
+				if err == nil || !strings.Contains(err.Error(), tt.want) {
+					t.Fatalf("error = %v, want %s", err, tt.want)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if len(got) != 1 || len(l.Data(got[0])) != 8 {
+				t.Fatalf("invalid records: %v", got)
+			}
+			rs := l.Relocs(got[0])
+			if rs.At(0).Sym() != f.Sym() || rs.At(0).Add() != 12 {
+				t.Fatal("lost function relocation")
+			}
+			fr := l.Relocs(f.Sym())
+			if fr.Count() != 1 || fr.At(0).Type() != objabi.R_KEEP || fr.At(0).Sym() != got[0] {
+				t.Fatal("function does not retain unwind record")
+			}
+			if tt.x {
+				found := false
+				for i := 0; i < rs.Count(); i++ {
+					if rs.At(i).Type() == objabi.R_KEEP && rs.At(i).Sym() == h.Sym() {
+						found = true
+					}
+				}
+				if !found {
+					t.Fatal("unwind handler not retained")
+				}
+			}
+		})
+	}
+}
