+++ b/src/cmd/link/internal/ld/seh.go
@@ -23,6 +23,8 @@ func collectSEH(ctxt *Link) {
 	switch ctxt.Arch.Family {
 	case sys.AMD64:
 		collectSEHAMD64(ctxt)
+	case sys.ARM64:
+		sortHostARM64SEH(ctxt)
 	}
 }
 
@@ -94,3 +96,21 @@ func collectSEHAMD64(ctxt *Link) {
 		sehp.xdata = append(sehp.xdata, xdata.Sym())
 	}
 }
+
+// Each ARM64 host entry is split by loadpe so its function RVA can determine
+// final ordering even when function sections have been reordered by the linker.
+func sortHostARM64SEH(ctxt *Link) {
+	ldr := ctxt.loader
+	sehp.pdata = slices.DeleteFunc(sehp.pdata, func(s loader.Sym) bool { return !ldr.AttrReachable(s) })
+	start := func(s loader.Sym) int64 {
+		rs := ldr.Relocs(s)
+		for i := 0; i < rs.Count(); i++ {
+			r := rs.At(i)
+			if r.Off() == 0 {
+				return ldr.SymAddr(r.Sym()) + r.Add()
+			}
+		}
+		return 0
+	}
+	slices.SortStableFunc(sehp.pdata, func(a, b loader.Sym) int { return cmp.Compare(start(a), start(b)) })
+}
