+
+func TestARM64HostUnwindOrdering(t *testing.T) {
+	saved := sehp
+	t.Cleanup(func() { sehp = saved })
+	l := loader.NewLoader(0, &loader.ErrorReporter{})
+	var records []loader.Sym
+	for _, v := range []int64{200, 0, 100} {
+		fn := l.MakeSymbolBuilder("")
+		fn.SetValue(v)
+		pd := l.MakeSymbolBuilder("")
+		r, _ := pd.AddRel(objabi.R_PEIMAGEOFF)
+		r.SetSym(fn.Sym())
+		r.SetSiz(4)
+		l.SetAttrReachable(fn.Sym(), v != 0)
+		l.SetAttrReachable(pd.Sym(), v != 0)
+		records = append(records, pd.Sym())
+	}
+	first, last := records[2], records[0]
+	sehp.pdata = records
+	sortHostARM64SEH(&Link{loader: l})
+	if len(sehp.pdata) != 2 || sehp.pdata[0] != first || sehp.pdata[1] != last {
+		t.Fatalf("unwind records not filtered and sorted: %v", sehp.pdata)
+	}
+}
