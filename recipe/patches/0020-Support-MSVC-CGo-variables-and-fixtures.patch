diff --git a/src/cmd/cgo/msvc_vars_test.go b/src/cmd/cgo/msvc_vars_test.go
new file mode 100644
index 0000000..e0d4ffe
--- /dev/null
+++ b/src/cmd/cgo/msvc_vars_test.go
@@ -0,0 +1,64 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+import (
+	"go/ast"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestMSVCVariableAddressGeneration(t *testing.T) {
+	savedOS, savedArch, savedDir := goos, goarch, *objDir
+	savedGccgo, savedGodefs := *gccgo, *godefs
+	t.Cleanup(func() {
+		goos, goarch, *objDir = savedOS, savedArch, savedDir
+		*gccgo, *godefs = savedGccgo, savedGodefs
+	})
+	*gccgo, *godefs = false, false
+	for _, test := range []struct {
+		name, os, arch string
+		msvc, wrapper  bool
+	}{
+		{"MSVC ARM64", "windows", "arm64", true, true},
+		{"MSVC x64", "windows", "amd64", true, true},
+		{"MinGW ARM64", "windows", "arm64", false, false},
+		{"Darwin", "darwin", "arm64", false, false},
+		{"MSVC macro outside Windows", "linux", "arm64", true, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			goos, goarch, *objDir = test.os, test.arch, t.TempDir()
+			n := &Name{Go: "value", C: "value", Kind: "var", Type: &Type{Size: 4, Align: 4, C: c("int"), Go: ast.NewIdent("int32")}}
+			f := &File{GccIsMSVC: test.msvc, Name: map[string]*Name{"value": n}}
+			p := &Package{PackageName: "test", PtrSize: 8, IntSize: 8, Written: make(map[string]bool)}
+			p.prepareNames(f)
+			p.Name = f.Name
+			p.writeDefs()
+			generated, err := os.ReadFile(filepath.Join(*objDir, "_cgo_gotypes.go"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			text := string(generated)
+			if test.wrapper {
+				if !strings.Contains(text, "var _Cvar_value *int32 = (*int32)(_Cvaraddr_value())") {
+					t.Fatalf("MSVC variable is not initialized through its C address wrapper:\n%s", text)
+				}
+				if strings.Contains(text, "//go:cgo_import_static value\n") || strings.Contains(text, "unsafe.Pointer(&__cgo_value)") {
+					t.Fatalf("MSVC variable still requires a direct data import:\n%s", text)
+				}
+				addr := f.Name["varaddr value"]
+				if addr == nil || addr.C != "(void *)&(value)" || addr.FuncType.Result.C.String() != "void*" {
+					t.Fatalf("incorrect C address expression: %#v", addr)
+				}
+			} else {
+				if strings.Contains(text, "_Cvaraddr_") || !strings.Contains(text, "unsafe.Pointer(&__cgo_value)") {
+					t.Fatalf("non-MSVC variable binding changed:\n%s", text)
+				}
+			}
+		})
+	}
+}
