Subject: [PATCH] Resolve MSVC CGo variable addresses and adapt compiler fixtures

diff --git a/src/cmd/cgo/gcc.go b/src/cmd/cgo/gcc.go
index b8b8d6b..609c30e 100644
--- a/src/cmd/cgo/gcc.go
+++ b/src/cmd/cgo/gcc.go
@@ -276,6 +276,9 @@ func (f *File) loadDefines(gccOptions []string) bool {
 		if key == "__clang__" {
 			gccIsClang = true
 		}
+		if key == "_MSC_VER" {
+			f.GccIsMSVC = true
+		}
 
 		if n := f.Name[key]; n != nil {
 			if *debugDefine {
@@ -798,6 +801,35 @@ func (p *Package) prepareNames(f *File) {
 			typedef[n.Mangle] = n.Type
 		}
 	}
+	if goos == "windows" && f.GccIsMSVC && !*gccgo && !*godefs {
+		// MSVC import libraries expose data through the import address
+		// table, not a directly linkable data symbol. Let the C compiler
+		// resolve addresses using each variable's declaration, including
+		// dllimport. Cache the address during Go package initialization so
+		// subsequent reads, writes, and address-taking need no C call.
+		for _, key := range nameKeys(f.Name) {
+			n := f.Name[key]
+			if n.Kind != "var" {
+				continue
+			}
+			addr := &Name{
+				Go:     n.Go,
+				Mangle: "_Cvaraddr_" + n.Go,
+				C:      "(void *)&(" + n.C + ")",
+				Kind:   "macro",
+				FuncType: &FuncType{
+					Result: &Type{Size: p.PtrSize, Align: p.PtrSize, C: c("void*"), Go: ast.NewIdent("unsafe.Pointer")},
+					Go: &ast.FuncType{
+						Results: &ast.FieldList{List: []*ast.Field{{Type: ast.NewIdent("unsafe.Pointer")}}},
+					},
+				},
+			}
+			n.VarAddr = addr.Mangle
+			// A space cannot occur in a source C identifier, so this key
+			// cannot collide with a name referred to by the user's Go code.
+			f.Name["varaddr "+n.Go] = addr
+		}
+	}
 }
 
 // mangleName does name mangling to translate names
diff --git a/src/cmd/cgo/internal/test/issue4054_test.go b/src/cmd/cgo/internal/test/issue4054_test.go
