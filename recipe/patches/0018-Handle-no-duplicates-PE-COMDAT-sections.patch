From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ClayWarren <warren.clay@icloud.com>
Date: Fri, 4 Sep 2026 00:00:00 +0000
Subject: [PATCH] cmd/link/internal/loadpe: handle no-duplicates COMDATs

MSVC-target Clang emits IMAGE_COMDAT_SELECT_NODUPLICATES (strategy 1)
for function sections. A single definition is valid; repeated definitions
must be rejected. Route these definitions through the existing ordinary
symbol duplicate checks instead of treating them as deduplicable COMDATs.

Clang can also emit several sections named .text in the same COFF object.
Include the section index in each outer symbol name so those sections keep
distinct data and symbol lists.

Exercise the full PE loader with portable ARM64 COFF fixtures, including
repeated section names, retained section contents, duplicate and mixed
NODUPLICATES selections, ANY, SAME_SIZE, and unsupported strategies.
---
diff --git a/src/cmd/link/internal/loadpe/ldpe.go b/src/cmd/link/internal/loadpe/ldpe.go
index fe39fad4..1fc21bb8 100644
--- a/src/cmd/link/internal/loadpe/ldpe.go
+++ b/src/cmd/link/internal/loadpe/ldpe.go
@@ -264,7 +264,7 @@ func Load(l *loader.Loader, arch *sys.Arch, localSymVersion int, input *bio.Read
 	// TODO return error if found .cormeta
 
 	// create symbols for mapped sections
-	for _, sect := range f.Sections {
+	for i, sect := range f.Sections {
 		if sect.Characteristics&pe.IMAGE_SCN_MEM_DISCARDABLE != 0 {
 			continue
 		}
@@ -275,7 +275,10 @@ func Load(l *loader.Loader, arch *sys.Arch, localSymVersion int, input *bio.Read
 			continue
 		}
 
-		name := fmt.Sprintf("%s(%s)", pkg, sect.Name)
+		// COFF permits multiple sections with the same name. Clang uses
+		// this for function COMDATs, so include the section index in the
+		// outer symbol's identity.
+		name := fmt.Sprintf("%s(%s:%d)", pkg, sect.Name, i)
 		s := state.l.LookupOrCreateCgoExport(name, localSymVersion)
 		bld := l.MakeSymbolUpdater(s)
 
@@ -799,6 +802,11 @@ func (state *peLoaderState) preprocessSymbols() error {
 		} else if auxsymp.Selection == pe.IMAGE_COMDAT_SELECT_ANY {
 			// Also supported.
 			state.comdats[uint16(pesym.SectionNumber-1)] = int64(-1)
+		} else if auxsymp.Selection == pe.IMAGE_COMDAT_SELECT_NODUPLICATES {
+			// A single definition is allowed, but duplicates must be
+			// diagnosed. Use the ordinary symbol duplicate checks instead
+			// of the COMDAT deduplication path.
+			delete(state.comdats, uint16(pesym.SectionNumber-1))
 		} else {
 			// We don't support any of the other strategies at the
 			// moment. I suspect that we may need to also support

diff --git a/src/cmd/link/internal/loadpe/ldpe_test.go b/src/cmd/link/internal/loadpe/ldpe_test.go
new file mode 100644
--- /dev/null
+++ b/src/cmd/link/internal/loadpe/ldpe_test.go
@@ -0,0 +1,165 @@
