+func TestWindowsCompilerRT(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "with spaces", "clang_rt.builtins-aarch64.lib")
+	for _, tt := range []struct {
+		name  string
+		flags []string
+		want  string
+	}{
+		{"selected", []string{"-nostdlib", "-Wl,-defaultlib:" + path}, path},
+		{"quoted", []string{"-Wl,-DEFAULTLIB:\"" + path + "\""}, path},
+		{"combined", []string{"-Wl,-opt:ref,-defaultlib:" + path}, path},
+		{"other", []string{"-Wl,-defaultlib:msvcrt.lib"}, ""},
+		{"gcc", []string{"-lgcc"}, ""},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			if got := windowsCompilerRT(tt.flags); got != tt.want {
+				t.Fatalf("got %q, want %q", got, tt.want)
+			}
+		})
+	}
+}
