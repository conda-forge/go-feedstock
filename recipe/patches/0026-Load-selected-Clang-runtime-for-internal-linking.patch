+
+// windowsCompilerRT finds an explicitly selected Clang runtime archive.
+// Other default libraries still belong to the external linker.
+func windowsCompilerRT(flags []string) string {
+	for _, flag := range flags {
+		if !strings.HasPrefix(flag, "-Wl,") {
+			continue
+		}
+		for _, arg := range strings.Split(strings.TrimPrefix(flag, "-Wl,"), ",") {
+			if !strings.HasPrefix(strings.ToLower(arg), "-defaultlib:") {
+				continue
+			}
+			path := strings.Trim(arg[len("-defaultlib:"):], "\"")
+			name := strings.ToLower(filepath.Base(path))
+			if strings.HasPrefix(name, "clang_rt.builtins") && strings.HasSuffix(name, ".lib") {
+				return path
+			}
+		}
+	}
+	return ""
 }
 
