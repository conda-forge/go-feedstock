From: ClayWarren <warren.clay@icloud.com>
Subject: [PATCH] Avoid CRT startup dependency in MSVC response-file probe

The capability probe links but never executes its output. When the caller
omits the CRT, give only this probe an explicit entry point so a missing
mainCRTStartup does not falsely disable response-file support.

--- a/src/cmd/link/internal/ld/lib.go
+++ b/src/cmd/link/internal/ld/lib.go
@@ -2180,7 +2180,13 @@
 	if err := os.WriteFile(response, nil, 0644); err != nil {
 		log.Fatalf("failed while testing response file: %v", err)
 	}
-	if !linkerFlagSupported(ctxt.Arch, argv[0], altLinker, "@"+response) {
+	var probeFlags []string
+	if ctxt.IsWindows() && ctxt.isMSVC() && slices.Contains(trimLinkerArgv(slices.Concat(ldflag, flagExtldflags)), "-nostdlib") {
+		// The probe only links; it never runs. Avoid requiring the CRT
+		// startup function when the caller intentionally omits the CRT.
+		probeFlags = []string{"-Wl,-entry:main"}
+	}
+	if !linkerFlagSupported(ctxt.Arch, argv[0], altLinker, "@"+response, probeFlags...) {
 		if ctxt.Debugvlog != 0 {
 			ctxt.Logf("not using response file because linker does not support one")
 		}
@@ -2206,7 +2212,7 @@
 
 var createTrivialCOnce sync.Once
 
-func linkerFlagSupported(arch *sys.Arch, linker, altLinker, flag string) bool {
+func linkerFlagSupported(arch *sys.Arch, linker, altLinker, flag string, probeFlags ...string) bool {
 	createTrivialCOnce.Do(func() {
 		src := filepath.Join(*flagTmpdir, "trivial.c")
 		if err := os.WriteFile(src, []byte("int main() { return 0; }"), 0666); err != nil {
@@ -2225,6 +2231,7 @@
 	trivialPath := filepath.Join(*flagTmpdir, "trivial.c")
 	outPath := filepath.Join(*flagTmpdir, "a.out")
 	flags = append(flags, "-o", outPath, flag, trivialPath)
+	flags = append(flags, probeFlags...)
 
 	cmd := exec.Command(linker, flags...)
 	cmd.Env = append([]string{"LC_ALL=C"}, os.Environ()...)
