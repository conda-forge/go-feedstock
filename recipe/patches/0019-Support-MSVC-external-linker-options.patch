+func TestWindowsMSVCSharedInitializer(t *testing.T) {
+	goTool := mustHaveMSVC(t)
+	testenv.MustHaveBuildMode(t, "c-shared")
+	dir := t.TempDir()
+	src := filepath.Join(dir, "main.go")
+	if err := os.WriteFile(src, []byte(`package main
+import "C"
+//export Answer
+func Answer() int { return 42 }
+func main() {}
+`), 0666); err != nil {
+		t.Fatal(err)
+	}
+	linktmp := filepath.Join(dir, "linktmp")
+	if err := os.Mkdir(linktmp, 0777); err != nil {
+		t.Fatal(err)
+	}
+	dll := filepath.Join(dir, "test.dll")
+	out, err := testenv.Command(t, goTool, "build", "-buildmode=c-shared", "-ldflags=-tmpdir="+linktmp, "-o", dll, src).CombinedOutput()
+	if err != nil {
+		t.Fatalf("building shared library: %v\n%s", err, out)
+	}
+	f, err := pe.Open(filepath.Join(linktmp, "go.o"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if f.Section(".ctors") != nil {
+		t.Error("MSVC shared library still uses a MinGW initializer")
+	}
+	init := f.Section(".CRT$XCU")
+	if init == nil {
+		t.Fatal("MSVC shared library has no CRT initializer")
+	}
+	if len(init.Relocs) != 1 {
+		t.Errorf("CRT initializer has %d relocations, want 1", len(init.Relocs))
+	}
+}
