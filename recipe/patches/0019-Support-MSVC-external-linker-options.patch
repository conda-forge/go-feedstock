+func TestWindowsGDBLinkerScript(t *testing.T) {
+	for _, test := range []struct {
+		name            string
+		msvc, lld, want bool
+	}{
+		{"GNU ld", false, false, true},
+		{"MinGW LLD", false, true, false},
+		{"Microsoft LINK", true, false, false},
+		{"MSVC LLD", true, true, false},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := windowsNeedsGDBLinkerScript(test.msvc, test.lld); got != test.want {
+				t.Fatalf("windowsNeedsGDBLinkerScript() = %v, want %v", got, test.want)
+			}
+		})
+	}
+}
+
+func TestMSVCDebugFlags(t *testing.T) {
+	for _, test := range []struct {
+		name                     string
+		stripSymbols, stripDWARF bool
+		want                     []string
+	}{
+		{"default", false, false, []string{"-Wl,-debug:dwarf", "-Wl,-opt:ref"}},
+		{"symbols only", false, true, []string{"-Wl,-debug:symtab", "-Wl,-debug:nodwarf", "-Wl,-opt:ref"}},
+		{"stripped", true, true, []string{"-Wl,-debug:none"}},
+		{"strip symbols implies no DWARF", true, false, []string{"-Wl,-debug:none"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			if got := msvcDebugFlags(test.stripSymbols, test.stripDWARF); !slices.Equal(got, test.want) {
+				t.Fatalf("msvcDebugFlags() = %q, want %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestDefaultExternalLinker(t *testing.T) {
+	for _, test := range []struct {
+		name, goos, goarch, cc string
+		want                   []string
+	}{
+		{"native ARM64 default", "windows", "arm64", "", []string{"clang.exe"}},
+		{"native ARM64 activation", "windows", "arm64", "clang.exe", []string{"clang.exe"}},
+		{"quoted compiler", "windows", "arm64", `"C:\Program Files\LLVM\bin\clang.exe" -fuse-ld=lld`, []string{`C:\Program Files\LLVM\bin\clang.exe`, "-fuse-ld=lld"}},
+		{"Windows x64 unchanged", "windows", "amd64", "clang.exe", []string{"gcc"}},
+		{"Windows x86 unchanged", "windows", "386", "clang.exe", []string{"gcc"}},
+		{"Linux unchanged", "linux", "arm64", "clang", []string{"gcc"}},
+		{"Darwin unchanged", "darwin", "arm64", "gcc", []string{"clang"}},
+		{"FreeBSD unchanged", "freebsd", "amd64", "gcc", []string{"clang"}},
+		{"OpenBSD unchanged", "openbsd", "amd64", "gcc", []string{"clang"}},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := defaultExternalLinker(test.goos, test.goarch, test.cc)
+			if err != nil || !slices.Equal(got, test.want) {
+				t.Fatalf("defaultExternalLinker() = %q, %v; want %q", got, err, test.want)
+			}
+		})
+	}
+	if _, err := defaultExternalLinker("windows", "arm64", `"unterminated`); err == nil {
+		t.Error("malformed CC did not return an error")
+	}
+
+	saved := flagExtld
+	defer func() { flagExtld = saved }()
+	want := []string{"explicit-linker", "explicit-argument"}
+	flagExtld = slices.Clone(want)
+	if got := new(Link).extld(); !slices.Equal(got, want) {
+		t.Fatalf("explicit -extld was replaced: %q", got)
+	}
+}
+
+func mustHaveMSVC(t *testing.T) string {
+	t.Helper()
+	if runtime.GOOS != "windows" {
+		t.Skip("Windows PE executable test")
+	}
+	testenv.MustHaveGoBuild(t)
+	testenv.MustHaveCGO(t)
+	goTool := testenv.GoToolPath(t)
+	ccOutput, err := testenv.Command(t, goTool, "env", "CC").Output()
+	if err != nil {
+		t.Fatal(err)
+	}
+	cc, err := quoted.Split(strings.TrimSpace(string(ccOutput)))
+	if err != nil || len(cc) == 0 {
+		t.Fatalf("invalid CC %q: %v", ccOutput, err)
+	}
+	version, err := testenv.Command(t, cc[0], append(cc[1:], "--version")...).CombinedOutput()
+	if err != nil {
+		t.Fatalf("querying CC: %v\n%s", err, version)
+	}
+	if !bytes.Contains(version, []byte("-msvc")) {
+		t.Skip("requires MSVC-target Clang")
+	}
+	return goTool
+}
