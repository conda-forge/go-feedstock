+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package cgotest
+
+import "testing"
+
+func TestVariableAddressShadowing(t *testing.T) {
+	if got, want := variableAddressValues(), [4]int{42, 43, 44, 45}; got != want {
+		t.Fatalf("C globals with wrapper-local names: got %v, want %v", got, want)
+	}
+}
