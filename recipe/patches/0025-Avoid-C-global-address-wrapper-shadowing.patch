+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package cgotest
+
+/*
+static int v = 42;
+static int _cgo_a = 43;
+static int _cgo_r = 44;
+static int _cgo_stktop = 45;
+*/
+import "C"
+
+func variableAddressValues() [4]int {
+	return [4]int{int(C.v), int(C._cgo_a), int(C._cgo_r), int(C._cgo_stktop)}
+}
